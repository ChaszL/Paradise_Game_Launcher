<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameLauncher"
        Title="Paradise Launcher" WindowState="Maximized" 
        Background="{Binding CurrentSettings.BackgroundColor}">

    <Window.Resources>
        <!-- The new converter that calculates circle fill -->
        <local:ProgressToDashArrayConverter x:Key="ProgressConverter"/>

        <!-- Custom ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#444" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced Modern Banner Style -->
        <Style x:Key="ModernBannerStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="12">
                            <Border Background="#1A1A1A" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.5" Direction="270" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="12" ClipToBounds="True">
                                <Image Source="{Binding GridUrl}" Stretch="UniformToFill" />
                            </Border>
                            <Border x:Name="HoverOverlay" Background="Black" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/>
                            <Border x:Name="HighlightBorder" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.10"/>
                                <Setter TargetName="HighlightBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Enhanced TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{Binding DataContext.CurrentSettings.LogoColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Overlay Gradient for Depth -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00000000" Offset="0.0"/>
                <GradientStop Color="#1A000000" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Content Area (Scrolls beneath Navbar) -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                <StackPanel Margin="30,20,30,40">

                    <!-- LARGE SYSTEM STATS CIRCLES -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,60">
                        
                        <!-- Circle 1: CPU -->
                        <Grid Margin="35,0" ToolTip="CPU Utilization">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.CPUColor, TargetNullValue='#ff9f00'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.CPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.CPUUsage, TargetNullValue='30%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.CPUColor, TargetNullValue='#ff9f00'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="CPU" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Circle 2: GPU -->
                        <Grid Margin="35,0" ToolTip="RX 9070 XT Utilization">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.GPUColor, TargetNullValue='#42b883'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.GPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.GPUUsage, TargetNullValue='60%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.GPUColor, TargetNullValue='#42b883'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="GPU" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Circle 3: RAM -->
                        <Grid Margin="35,0" ToolTip="RAM Usage">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.RAMColor, TargetNullValue='#3498db'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.RAMValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.RAMUsage, TargetNullValue='90%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.RAMColor, TargetNullValue='#3498db'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="RAM" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <StackPanel x:Name="RecentsBlock" Margin="0,0,0,60">
                        <TextBlock Text="RECENTLY PLAYED" Foreground="#666" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- Added HorizontalScrollBarVisibility="Hidden" -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Launch_Click" 
                                                Style="{StaticResource ModernBannerStyle}"
                                                Width="{Binding DataContext.CurrentSettings.RecentsBannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.CurrentSettings.RecentsBannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Text="ALL INSTALLED GAMES" Foreground="#666" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <ItemsControl x:Name="GameItemsControl" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Launch_Click" 
                                        Style="{StaticResource ModernBannerStyle}"
                                        Width="{Binding DataContext.CurrentSettings.BannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.CurrentSettings.BannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Navbar (Row 0, drawn on top for shadow effect) -->
        <Border Grid.Row="0" Background="{Binding CurrentSettings.NavbarColor}" Opacity="0.98">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>
            <DockPanel VerticalAlignment="Center" Margin="30,0">
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PARADISE" Foreground="{Binding CurrentSettings.LogoColor}" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="LAUNCHER" Foreground="White" FontSize="24" FontWeight="Light" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Persistent Mini HUD -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="50,0">
                    <Grid Margin="12,0" ToolTip="CPU Utilization">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.CPUColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.CPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.CPUUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="RX 9070 XT Utilization">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.GPUColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.GPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.GPUUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="RAM Usage">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.RAMColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.RAMValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.RAMUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="260" Height="38" 
                             Margin="0,0,25,0" TextChanged="SearchBox_TextChanged"
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="Search library..."/>
                   
                    <Button Content="⚙" Width="42" Height="42" Background="Transparent" Foreground="#AAA"
                            BorderThickness="0" FontSize="24" Click="OpenSettings_Click" Cursor="Hand"
                            ToolTip="Settings">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings Overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Grid.RowSpan="2">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.85"/>
            </Grid.Background>

            <Border Background="{Binding CurrentSettings.NavbarColor}" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Padding="40" CornerRadius="16" Width="550">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black"/>
                </Border.Effect>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="750">
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" Foreground="{Binding CurrentSettings.LogoColor}" 
                                FontSize="20" FontWeight="Black" Margin="0,0,0,35" HorizontalAlignment="Center"/>

                        <TextBlock Text="APPEARANCE" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Margin="0,0,0,25">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Background Hex" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentSettings.BackgroundColor}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Navbar Hex" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentSettings.NavbarColor}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="LIBRARY GRID SIZING" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Banner Width" Foreground="#AAA" FontSize="11"/>
                                <Slider Minimum="100" Maximum="400" Value="{Binding CurrentSettings.BannerWidth}" Margin="0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Banner Height" Foreground="#AAA" FontSize="11"/>
                                <Slider Minimum="150" Maximum="600" Value="{Binding CurrentSettings.BannerHeight}" Margin="0,8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="RECENTS GRID SIZING" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Recents Banner Width" Foreground="#AAA" FontSize="11"/>
                                <Slider Minimum="100" Maximum="400" Value="{Binding CurrentSettings.RecentsBannerWidth}" Margin="0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Recents Banner Height" Foreground="#AAA" FontSize="11"/>
                                <Slider Minimum="150" Maximum="600" Value="{Binding CurrentSettings.RecentsBannerHeight}" Margin="0,8"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#222" Margin="0,10,0,25"/>

                        <TextBlock Text="SYSTEM" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <TextBlock Text="SteamGridDB API Key" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CurrentSettings.SteamGridApiKey}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                        <TextBlock Text="Game Library Path" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CurrentSettings.GameLibraryPath}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,40"/>

                        <UniformGrid Columns="2" Height="48">
                            <Button Content="Save Changes" Click="SaveSettings_Click" Margin="0,0,10,0" 
                                    Background="{Binding CurrentSettings.LogoColor}" Foreground="Black" FontWeight="Heavy" FontSize="14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Content="Cancel" Click="CancelSettings_Click" Margin="10,0,0,0" 
                                    Background="#222" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>