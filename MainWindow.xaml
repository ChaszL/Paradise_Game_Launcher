<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paradise Launcher" WindowState="Maximized" 
        Background="{Binding CurrentSettings.BackgroundColor}">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#555" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBannerStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="10">
                            <Border Background="#1A1A1A" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.4" Direction="270" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Image Source="{Binding GridUrl}" Stretch="UniformToFill" />
                            </Border>
                            <Border x:Name="HoverOverlay" Background="Black" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{Binding CurrentSettings.NavbarColor}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Border.Effect>
            <DockPanel VerticalAlignment="Center" Margin="25,0">
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Paradise Launcher" Foreground="{Binding CurrentSettings.LogoColor}" FontSize="26" FontWeight="ExtraBlack" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0">
                    <Grid Margin="12,0" ToolTip="CPU Utilization">
                        <Ellipse Width="46" Height="46" Stroke="#11FFFFFF" StrokeThickness="4"/>
                        <Ellipse Width="46" Height="46" Stroke="{Binding Stats.CPUColor}" 
                                StrokeThickness="4" StrokeDashCap="Round" StrokeDashArray="10, 2"/> 
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CPU" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.CPUUsage}" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="GPU Utilization">
                        <Ellipse Width="46" Height="46" Stroke="#11FFFFFF" StrokeThickness="4"/>
                        <Ellipse Width="46" Height="46" Stroke="{Binding Stats.GPUColor}" 
                                StrokeThickness="4" StrokeDashCap="Round" StrokeDashArray="10, 2"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GPU" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.GPUUsage}" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="RAM Usage">
                        <Ellipse Width="46" Height="46" Stroke="#11FFFFFF" StrokeThickness="4"/>
                        <Ellipse Width="46" Height="46" Stroke="{Binding Stats.RAMColor}" 
                                StrokeThickness="4" StrokeDashCap="Round" StrokeDashArray="10, 2"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RAM" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.RAMUsage}" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="280" Height="36" 
                             Margin="0,0,20,0" TextChanged="SearchBox_TextChanged"
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="Search library..."/>
                   
                    <Button Content="⚙" Width="40" Height="40" Background="Transparent" Foreground="#DDD"
                            BorderThickness="0" FontSize="22" Click="OpenSettings_Click" Cursor="Hand"
                            ToolTip="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                <StackPanel Margin="30,10,30,30">

                    <StackPanel x:Name="RecentsBlock" Margin="0,0,0,40">
                        <TextBlock Text="RECENTLY PLAYED" Foreground="#888" FontSize="16" FontWeight="Heavy" Margin="15,0,0,10"/>
                        
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Launch_Click" 
                                                Style="{StaticResource ModernBannerStyle}"
                                                Width="{Binding DataContext.CurrentSettings.RecentsBannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.CurrentSettings.RecentsBannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Text="ALL INSTALLED GAMES" Foreground="#888" FontSize="16" FontWeight="Heavy" Margin="15,0,0,10"/>

                    <ItemsControl x:Name="GameItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Launch_Click" 
                                        Style="{StaticResource ModernBannerStyle}"
                                        Width="{Binding DataContext.CurrentSettings.BannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.CurrentSettings.BannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Grid.RowSpan="2">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.8"/>
            </Grid.Background>

            <Border Background="{Binding CurrentSettings.NavbarColor}" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Padding="40" CornerRadius="15" Width="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                </Border.Effect>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" Foreground="{Binding CurrentSettings.LogoColor}" 
                                FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                        <TextBlock Text="Appearance" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Background Hex" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CurrentSettings.BackgroundColor}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Navbar Hex" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CurrentSettings.NavbarColor}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Library Grid Sizing" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Banner Width" Foreground="#888" FontSize="11"/>
                                <Slider Minimum="100" Maximum="400" Value="{Binding CurrentSettings.BannerWidth}" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Banner Height" Foreground="#888" FontSize="11"/>
                                <Slider Minimum="150" Maximum="600" Value="{Binding CurrentSettings.BannerHeight}" Margin="0,5"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Recents Grid Sizing" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Recents Banner Width" Foreground="#888" FontSize="11"/>
                                <Slider Minimum="100" Maximum="400" Value="{Binding CurrentSettings.RecentsBannerWidth}" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Recents Banner Height" Foreground="#888" FontSize="11"/>
                                <Slider Minimum="150" Maximum="600" Value="{Binding CurrentSettings.RecentsBannerHeight}" Margin="0,5"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="#333" Margin="0,10,0,20"/>

                        <TextBlock Text="System" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="SteamGridDB API Key" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CurrentSettings.SteamGridApiKey}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="Game Library Path" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CurrentSettings.GameLibraryPath}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,30"/>

                        <UniformGrid Columns="2" Height="45">
                            <Button Content="Save Changes" Click="SaveSettings_Click" Margin="0,0,8,0" 
                                    Background="{Binding CurrentSettings.LogoColor}" Foreground="Black" FontWeight="Bold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Content="Cancel" Click="CancelSettings_Click" Margin="8,0,0,0" 
                                    Background="#333" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>