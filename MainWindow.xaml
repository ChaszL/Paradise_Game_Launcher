<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameLauncher"
        Title="Paradise Launcher" WindowState="Maximized" 
        Background="{Binding CurrentSettings.BackgroundColor}">

    <Window.Resources>
        <!-- The new converter that calculates circle fill -->
        <local:ProgressToDashArrayConverter x:Key="ProgressConverter"/>

        <!-- Custom ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#444" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced Modern Banner Style -->
        <Style x:Key="ModernBannerStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="12">
                            <Border Background="#1A1A1A" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.35" Direction="270" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding GridUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border VerticalAlignment="Bottom">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#D0000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Padding="6,10,6,6" IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="InstallBadge" Background="#CCB00020" CornerRadius="6" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="NOT INSTALLED" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="HoverOverlay" Background="Black" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Installed}" Value="False">
                                <Setter TargetName="InstallBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Enhanced TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{Binding DataContext.CurrentSettings.LogoColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <TextBlock Margin="12,8,28,8"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"
                                                           Text="{TemplateBinding Content}" />
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#1A1A1A"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Overlay Gradient for Depth -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00000000" Offset="0.0"/>
                <GradientStop Color="#1A000000" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Content Area (Scrolls beneath Navbar) -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MainContentScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                <StackPanel Margin="30,20,30,40">

                    <!-- LARGE SYSTEM STATS CIRCLES -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,60">
                        
                        <!-- Circle 1: CPU -->
                        <Grid Margin="35,0" ToolTip="CPU Utilization">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.CPUColor, TargetNullValue='#ff9f00'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.CPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.CPUUsage, TargetNullValue='30%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.CPUColor, TargetNullValue='#ff9f00'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="CPU" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Circle 2: GPU -->
                        <Grid Margin="35,0" ToolTip="RX 9070 XT Utilization">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.GPUColor, TargetNullValue='#42b883'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.GPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.GPUUsage, TargetNullValue='60%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.GPUColor, TargetNullValue='#42b883'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="GPU" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Circle 3: RAM -->
                        <Grid Margin="35,0" ToolTip="RAM Usage">
                            <Ellipse Width="180" Height="180" Stroke="#1A1A1A" StrokeThickness="16">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="180" Height="180" Stroke="{Binding Stats.RAMColor, TargetNullValue='#3498db'}" 
                                     StrokeThickness="16" StrokeDashCap="Round" 
                                     StrokeDashArray="{Binding Stats.RAMValue, Converter={StaticResource ProgressConverter}, ConverterParameter='32.2013'}"
                                     RenderTransformOrigin="0.5, 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stats.RAMUsage, TargetNullValue='90%'}" FontSize="42" Foreground="White" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.5" ShadowDepth="0" Color="{Binding Stats.RAMColor, TargetNullValue='#3498db'}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="RAM" FontSize="15" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <StackPanel x:Name="RecentsBlock" Margin="0,0,0,60" PreviewMouseWheel="RecentsBlock_PreviewMouseWheel">
                        <TextBlock Text="RECENTLY PLAYED" Foreground="#666" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Launch_Click" 
                                                Style="{StaticResource ModernBannerStyle}"
                                                Width="{Binding DataContext.CurrentSettings.RecentsBannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.CurrentSettings.RecentsBannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Text="ALL INSTALLED GAMES" Foreground="#666" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <ItemsControl x:Name="GameItemsControl" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12">
                                    <Button Click="Launch_Click" 
                                            Style="{StaticResource ModernBannerStyle}"
                                            Width="{Binding DataContext.CurrentSettings.BannerWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{Binding DataContext.CurrentSettings.BannerHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Navbar (Row 0, drawn on top for shadow effect) -->
        <Border x:Name="TopNavbarBorder" Grid.Row="0" Background="{Binding CurrentSettings.NavbarColor}" Opacity="0.98">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>
            <DockPanel VerticalAlignment="Center" Margin="30,0">
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PARADISE" Foreground="{Binding CurrentSettings.LogoColor}" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="LAUNCHER" Foreground="White" FontSize="24" FontWeight="Light" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Persistent Mini HUD -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="50,0">
                    <Grid Margin="12,0" ToolTip="CPU Utilization">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.CPUColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.CPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.CPUUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="RX 9070 XT Utilization">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.GPUColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.GPUValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.GPUUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,0" ToolTip="RAM Usage">
                        <Ellipse Width="42" Height="42" Stroke="#11FFFFFF" StrokeThickness="3"/>
                        <Ellipse Width="42" Height="42" Stroke="{Binding Stats.RAMColor}" 
                                 StrokeThickness="3" StrokeDashCap="Round" 
                                 StrokeDashArray="{Binding Stats.RAMValue, Converter={StaticResource ProgressConverter}, ConverterParameter='40.8407'}"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stats.RAMUsage}" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="CategoryFilterBox" Width="220" Height="38"
                              Margin="0,0,15,0"
                              Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding FilterCategories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              SelectionChanged="CategoryFilter_SelectionChanged"
                              ToolTip="Filter by category"
                              IsEditable="False"/>

                    <TextBox x:Name="SearchBox" Width="260" Height="38" 
                             Margin="0,0,25,0" TextChanged="SearchBox_TextChanged"
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="Search library..."/>
                   
                    <Button Content="⚙" Width="42" Height="42" Background="Transparent" Foreground="#AAA"
                            BorderThickness="0" FontSize="24" Click="OpenSettings_Click" Cursor="Hand"
                            ToolTip="Settings">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings Overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Grid.RowSpan="2">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.85"/>
            </Grid.Background>

                <Border x:Name="SettingsPanelBorder" Background="{Binding CurrentSettings.NavbarColor}" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Padding="40" CornerRadius="16" Width="550">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black"/>
                </Border.Effect>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="750">
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" Foreground="{Binding CurrentSettings.LogoColor}" 
                                FontSize="20" FontWeight="Black" Margin="0,0,0,35" HorizontalAlignment="Center"/>

                        <TextBlock Text="APPEARANCE" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,25">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="ColorTargetBox" Grid.Column="0" Style="{StaticResource ModernComboBox}" SelectionChanged="ColorTargetBox_SelectionChanged" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Edit Background Color" Tag="Background"/>
                                        <ComboBoxItem Content="Edit Navbar Color" Tag="Navbar"/>
                                    </ComboBox>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="BG" Foreground="#777" FontSize="10" HorizontalAlignment="Center"/>
                                            <Border x:Name="BackgroundCurrentPreview" Width="30" Height="24" BorderBrush="#555" BorderThickness="1" CornerRadius="4"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="NAV" Foreground="#777" FontSize="10" HorizontalAlignment="Center"/>
                                            <Border x:Name="NavbarCurrentPreview" Width="30" Height="24" BorderBrush="#555" BorderThickness="1" CornerRadius="4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Canvas x:Name="SVCanvas" Height="220" Background="Transparent" MouseDown="SVCanvas_MouseDown" MouseMove="SVCanvas_MouseMove" MouseUp="SVCanvas_MouseUp" SizeChanged="SVCanvas_SizeChanged" Margin="0,0,0,10">
                                    <Rectangle Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" x:Name="SVHueBase" Fill="#FF0000" RadiusX="8" RadiusY="8"/>
                                    <Rectangle Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" RadiusX="8" RadiusY="8">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" RadiusX="8" RadiusY="8">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Ellipse x:Name="SVSelector" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
                                </Canvas>

                                <Grid Height="24" Margin="0,0,0,10">
                                    <Rectangle RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#FF0000" Offset="0.00"/>
                                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                                <GradientStop Color="#00FFFF" Offset="0.50"/>
                                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                <GradientStop Color="#FF0000" Offset="1.00"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Slider x:Name="HueSlider" Minimum="0" Maximum="359" ValueChanged="HueSlider_ValueChanged" Background="#00FFFFFF" Foreground="#00FFFFFF" BorderBrush="#00FFFFFF"/>
                                </Grid>

                                <TextBox x:Name="PickerHexBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" TextChanged="PickerHexBox_TextChanged"/>

                                <UniformGrid Columns="4">
                                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="RGB" Foreground="#777" FontSize="10"/>
                                            <TextBlock x:Name="RgbValueText" Foreground="White" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="CMYK" Foreground="#777" FontSize="10"/>
                                            <TextBlock x:Name="CmykValueText" Foreground="White" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="HSV" Foreground="#777" FontSize="10"/>
                                            <TextBlock x:Name="HsvValueText" Foreground="White" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="HSL" Foreground="#777" FontSize="10"/>
                                            <TextBlock x:Name="HslValueText" Foreground="White" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="LIBRARY GRID SIZING" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <TextBlock Text="Library Banner Scale" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LibraryBannerScaleBox"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="LibraryBannerScaleBox_SelectionChanged"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="Small (130 x 195)" Tag="130x195"/>
                            <ComboBoxItem Content="Default (150 x 225)" Tag="150x225"/>
                            <ComboBoxItem Content="Large (180 x 270)" Tag="180x270"/>
                            <ComboBoxItem Content="Extra Large (220 x 330)" Tag="220x330"/>
                        </ComboBox>

                        <TextBlock Text="RECENTS GRID SIZING" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <TextBlock Text="Recents Banner Scale" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RecentsBannerScaleBox"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="RecentsBannerScaleBox_SelectionChanged"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="Small (80 x 120)" Tag="80x120"/>
                            <ComboBoxItem Content="Default (100 x 150)" Tag="100x150"/>
                            <ComboBoxItem Content="Large (120 x 180)" Tag="120x180"/>
                            <ComboBoxItem Content="Extra Large (140 x 210)" Tag="140x210"/>
                        </ComboBox>

                        <Rectangle Height="1" Fill="#222" Margin="0,10,0,25"/>

                        <TextBlock Text="SYSTEM" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,12"/>
                        <TextBlock Text="Game Library Path" Foreground="#AAA" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameLibraryPathBox" Text="{Binding CurrentSettings.GameLibraryPath}" Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseGameLibraryPath_Click"
                                    Background="#222" Foreground="White" FontWeight="Bold" Cursor="Hand" Padding="14,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <TextBlock Text="CATEGORIES" Foreground="#777" FontSize="12" FontWeight="Black" Margin="0,0,0,10"/>
                        <TextBlock Text="Add a category or change categories from the manager." Foreground="#AAA" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewCategoryBox" Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Add Category" Click="AddCategory_Click"
                                    Background="#222" Foreground="White" FontWeight="Bold" Cursor="Hand" Padding="14,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Button Content="Open Game Category Manager" Click="OpenCategoryManager_Click" Margin="0,0,0,8"
                                Background="#222" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Padding="14,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border x:Name="CategoryManagerPanel" Visibility="Collapsed" Background="#121212" BorderBrush="#333" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Select a game below to see its current category and change it instantly." Foreground="#AAA" FontSize="11" Margin="0,0,0,8"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A1A1A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Category, StringFormat='Current: {0}'}" Foreground="#AAA" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  Margin="8,0,0,0"
                                                                  Style="{StaticResource ModernComboBox}"
                                                                  ItemsSource="{Binding DataContext.AssignableCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Category, Mode=OneWay}"
                                                                  SelectionChanged="CategorySelection_Changed"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Height="48">
                            <Button Content="Save Changes" Click="SaveSettings_Click" Margin="0,0,10,0" 
                                    Background="{Binding CurrentSettings.LogoColor}" Foreground="Black" FontWeight="Heavy" FontSize="14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Content="Cancel" Click="CancelSettings_Click" Margin="10,0,0,0" 
                                    Background="#222" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>